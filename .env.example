# Lull sunucusu — ortam degiskenleri.
#
# Railway'de bunlar "Variables" sekmesine girilir. Bu dosya YALNIZCA ornek;
# gercek degerleri buraya YAZMA, `.env` git'e girmiyor ama bu dosya giriyor.

# ── zorunlu ──────────────────────────────────────────────────────

# Sunucunun herkese acik alan adi. Giris mesaji buna gore uretilir ve
# cuzdan kullaniciya "<alan adi> giris istiyor" der; yanlissa kullanici
# kafasi karisir. Basinda https:// YOK.
LULL_HOME_DOMAIN=lull-arc.up.railway.app

# IP hash'leme tuzu. Uretimde ZORUNLU — yoksa sunucu acilmaz. Rastgele ve gizli. Degistirilirse eski hash'ler
# eslesmez — fraud kurallari gecmisi kaybeder.
LULL_IP_SALT=

# ── ag ───────────────────────────────────────────────────────────

# `testnet` (varsayilan) veya `mainnet`. Yanlis yazim sessizce testnet'e
# DUSMEZ; sunucu hic acilmaz.
# LULL_NETWORK=mainnet

# RPC adresi. Bos birakilirsa Arc'in herkese acik RPC'si kullanilir.
# LULL_RPC=https://rpc.mainnet.arc.io

# USDC (ERC-20 arayuzu). Arc'ta iki agda da 0x3600…0000; yalnizca yerel
# testlerde (anvil + sahte token) degistirilir. Kendi token'ini KOYMA.
# LULL_USDC=0x3600000000000000000000000000000000000000

# ── odeme (bunlar olmadan odeme KAPALI kalir) ────────────────────

# LullVault kontratinin adresi. Reklamveren parayi buraya gonderir,
# odemeler buradan cikar. Deploy: contracts/vault/README.md
LULL_VAULT=

# Kasanin deploy edildigi blok. Yatirma taramasi buradan baslar.
LULL_VAULT_FROM_BLOCK=

# Operator cuzdaninin gizli anahtari (32 bayt hex). Kasada `operator` olarak
# kayitli adres bu olmali. Para BURADA DURMAZ — kasada durur; operator
# yalnizca odeme cagrisini imzalar ve gazini oder. Icinde gaz icin biraz
# USDC olmali (en az 0.5 USDC — altina inince odeme durur). Uret:
#   cast wallet new
LULL_OPERATOR_KEY=

# Kalici depolama. Railway'de bir Volume olusturup `/data`'ya baglayin.
# TANIMSIZ birakilirsa her sey BELLEKTE kalir ve her deploy'da bakiyeler
# silinir — sunucu acilista bunu gurultuyle uyarir.
LULL_DB=/data/lull.db

# Platform paneli (`/v1/admin/*`) icin paylasilan sir. Cuzdan tabanli giris
# akisina girmiyor — ortada "admin cuzdani" diye bir kimlik yok, tipki
# LULL_OPERATOR_KEY gibi tek bir kisi (platform operatoru) kullaniyor.
# TANIMSIZ birakilirsa /v1/admin/* uclari hic acilmaz. Uret:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
LULL_ADMIN_SECRET=

# ── istege bagli ─────────────────────────────────────────────────

# LULL_DEPOSIT_INTERVAL_MS=20000     # yatirma taramasi araligi
# LULL_PENDING_MS=86400000           # dogrulama bekleme suresi. Uretimde varsayilan 24 saat,
#                                     # mainnet'te 1 saatin altindaki deger sunucuyu ACMAZ; testnet
#                                     # demoda kisaltilabilir (orn. 30000). Gelistirmede 30 sn.
# LULL_MIN_CLIENT_VERSION=0.1.13     # ADR-016 surum kapisi; altindaki istemciler reddedilir
# LULL_RECONCILE_MS=60000            # asili cekimlerin zincirle mutabakat araligi
# LULL_WALLET_HOLD_MS=259200000      # cuzdan degisikligi sonrasi bekleme (72 saat)
